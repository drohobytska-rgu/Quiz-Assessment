const prompt = require("readline-sync")

let points = 3;
let usedHint = false; // Vlad, set this to true if they use a hint, so that we can deduct points later on. Scrap if already have a variable for this but we will need to link the time & hint usage together to the points system.
let timeTaken;

while(true) {
    let startTime = Date.now();
    prompt.question("What does VPN stand for?" )   //reference for Date.now() function: MDN contributors. (n.d.). Date.Now() - JavaScript | MDN. Developer.Mozilla.Org. Retrieved September 28, 2026, from https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Date/now
    let endTime = Date.now()

    timeTaken = ((endTime - startTime) / 1000); //(/ 1000) is to convert from milliseconds to seconds

if (timeTaken > 60) {
    console.log("You took over 60 seconds. Please try again!"); //if they take over 60 seconds, they will be prompted to try again. This is to prevent them from taking too long and to keep the game moving.

    } else{
        break;
    }
}

console.log("You took " + (Math.floor(timeTaken)) + " seconds to answer this question!");

if (timeTaken >= 20) {
    console.log("You took over 20 seconds to answer this question!");
    points = points - 1;
}

if (usedHint) {
    points = points - 1; 
}

console.log("You got " + points + " points.");
